# syntax=docker/dockerfile:1
FROM rust:1-slim AS build
# build-essential + cmake: dependencies compile C/C++ via cc-rs/cmake.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential cmake \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY .sqlx ./.sqlx
COPY backend ./backend
COPY crates ./crates
# sqlx query! macros compile offline against the .sqlx query metadata
# (regenerate with: DATABASE_URL=... cargo sqlx prepare --workspace).
ENV SQLX_OFFLINE=true
RUN cargo build --release -p backend

# Hub-only build: the client-test stack uses a tiny proto-rs stub hub instead
# of the model server, so no MLX/model deps are needed at runtime.
RUN cargo build --release -p proto-rs --example hub_stub

FROM debian:stable-slim AS backend-runtime
# curl for in-container API tests (the stack publishes no ports); certs for https probes.
# node + @openai/codex: the codex oauth bridge and `codex exec` need the CLI
# in the image (there is no codex on the container PATH otherwise).
# socat: relays the published 1455 callback port to codex's 127.0.0.1 listener.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl nodejs npm socat \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex @anthropic-ai/claude-code
COPY docker/entrypoint-backend.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint
COPY --from=build /app/target/release/backend /usr/local/bin/backend
WORKDIR /app
EXPOSE 8991
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]

# Hub-only runtime (docker-compose.client-test.yml): tiny stub hub that
# registers client nodes and round-trips a probe command to each.
FROM debian:stable-slim AS hub-runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/release/examples/hub_stub /usr/local/bin/hub_stub
ENV HUB_PORT=8993
EXPOSE 8993
ENTRYPOINT ["hub_stub"]
