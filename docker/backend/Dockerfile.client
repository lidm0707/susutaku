# Client-node test container: a minimal worker machine that runs the backend
# binary as a sandbox client (SUSUTAKU_HUB_ADDR points at the hub service).
# Reuses the built backend artifact from the already-built backend image.
#
#   docker compose -f docker/docker-compose.client-test.yml up --build -d
#
# Needs the same security_opt as the backend: the client executes hub
# commands inside the rootless sandbox (by design, no unsandboxed fallback).
FROM debian:stable-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=susutaku-sandbox-backend:latest /usr/local/bin/backend /usr/local/bin/backend

# Client-node identity: registers with the hub as a worker, serves hub
# commands in its own rootless sandbox.
ENV SUSUTAKU_HUB_ADDR=hub:8993
CMD ["backend"]
